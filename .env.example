# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hootsute_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# DATABASE_URL for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hootsute_db?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hootsute_test_db?schema=public"

# ==========================================
# BACKEND API (NestJS) CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# JWT Configuration (Replace with strong random strings in production)
JWT_ACCESS_SECRET="dev-jwt-access-secret-minimum-32-characters-required-for-security"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-minimum-32-characters-required-for-security"
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting & Distributed Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Redis for Distributed Rate Limiting (optional in dev; recommended in production)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
# Fallback policy when Redis is unavailable: 'fail-closed' (production default) or 'local-fallback'
RATE_LIMIT_REDIS_FALLBACK="fail-closed"

# Structured Production Logging
LOG_FORMAT="text" # 'json' in production, 'text' in local development

# Inbox Reply Reconciliation
DISABLE_REPLY_RECONCILER="false" # set to 'true' only if worker is run as dedicated microservice

# Token Vault Encryption (32-byte hex key for AES-256-GCM credential encryption at rest)
TOKEN_ENCRYPTION_KEY="replace-with-64-character-hex-string-for-aes-256-gcm-encryption"

# ==========================================
# META / FACEBOOK / INSTAGRAM OAUTH CONFIGURATION
# ==========================================
META_APP_ID=""
META_APP_SECRET=""
META_API_VERSION="v21.0"
META_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/oauth/meta/callback"

# ==========================================
# FRONTEND (Next.js) CONFIGURATION
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="OmniSocial AI"
