# ==============================================================================
# OmniSocial AI — Staging Environment Template (.env.staging.example)
# ==============================================================================
# Copy this file to .env.staging on your staging host and configure staging-only secrets.
# NEVER use production secrets or credentials in this environment.
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=4001
API_PREFIX=/api/v1
LOG_FORMAT=json

# Staging Database (Isolated Postgres Instance)
STAGING_POSTGRES_USER=staging_app
STAGING_POSTGRES_PASSWORD=replace-with-strong-staging-db-password-min-24-chars
STAGING_POSTGRES_DB=omnisocial_staging_db
DATABASE_URL=postgresql://${STAGING_POSTGRES_USER}:${STAGING_POSTGRES_PASSWORD}@postgres:5432/${STAGING_POSTGRES_DB}?schema=public

# Staging Redis (Isolated Redis Instance)
STAGING_REDIS_PASSWORD=replace-with-strong-staging-redis-password-min-32-chars
REDIS_URL=redis://:${STAGING_REDIS_PASSWORD}@redis:6379
RATE_LIMIT_REDIS_FALLBACK=fail-closed

# Staging JWT Secrets (Distinct from production, >= 32 characters, high entropy)
JWT_ACCESS_SECRET=replace-with-staging-jwt-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=replace-with-staging-jwt-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Staging Token Encryption Key (64-character hexadecimal, distinct from production)
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-character-hex-string-for-staging-encryption-only

# Staging Domain & CORS Configuration (Explicit staging domain, no wildcards, no localhost in prod mode)
STAGING_CORS_ORIGIN=https://staging-app.omnisocial.ai
CORS_ORIGIN=https://staging-app.omnisocial.ai
STAGING_COOKIE_DOMAIN=staging-app.omnisocial.ai
COOKIE_DOMAIN=staging-app.omnisocial.ai
COOKIE_SECURE=true

# Staging Frontend API URL
STAGING_NEXT_PUBLIC_API_URL=https://staging-api.omnisocial.ai/api/v1
NEXT_PUBLIC_API_URL=https://staging-api.omnisocial.ai/api/v1
NEXT_PUBLIC_APP_NAME="OmniSocial AI (Staging)"

# Meta Test / Staging Configuration (Use Meta App in Development Mode with Test Accounts)
META_APP_ID=replace-with-meta-staging-app-id
META_APP_SECRET=replace-with-meta-staging-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-staging-meta-webhook-verify-token
META_OAUTH_REDIRECT_URI=https://staging-api.omnisocial.ai/api/v1/oauth/meta/callback
META_API_VERSION=v21.0

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
