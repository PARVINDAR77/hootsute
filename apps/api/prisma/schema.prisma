generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  BUSINESS_ADMIN
  BUSINESS_MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SocialProvider {
  META_FACEBOOK
  META_INSTAGRAM
  LINKEDIN
  TWITTER_X
  PINTEREST
  YOUTUBE
  TIKTOK
  THREADS
}

enum SocialAccountType {
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
  INSTAGRAM_CREATOR
  LINKEDIN_PAGE
  LINKEDIN_PROFILE
  TWITTER_PROFILE
  PINTEREST_BUSINESS
  YOUTUBE_CHANNEL
  TIKTOK_BUSINESS
  TIKTOK_CREATOR
  THREADS_PROFILE
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum DraftStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SKIPPED
}

enum CampaignObjective {
  ENGAGEMENT
  SALES_LEADS
  ANNOUNCEMENT
  FESTIVAL_WISHES
  BRAND_AWARENESS
  EVENT_PROMOTION
  EDUCATIONAL
  RECRUITMENT
}

enum ContentType {
  POST
  REEL_STORY_BRIEF
  CAROUSEL
  CAMPAIGN
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER_X
  PINTEREST
  YOUTUBE
  TIKTOK
  THREADS
}

enum ListeningSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum BrandTone {
  PROFESSIONAL
  CASUAL_FRIENDLY
  FESTIVE_WARM
  INSPIRATIONAL
  URGENT_PROMOTIONAL
  AUTHORITATIVE
  PLAYFUL
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaProcessingStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MediaStorageProvider {
  S3
  LOCAL_MOCK
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum AutomationTriggerType {
  INBOX_NEW_MESSAGE
  OCCASION_UPCOMING
  POST_PUBLISHED
  POST_HIGH_PERFORMANCE
}

enum AutomationActionType {
  AUTO_REPLY
  AUTO_HIDE_SPAM
  GENERATE_AI_DRAFT
  DISPATCH_WEBHOOK
  RECYCLE_POST
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String
  role            Role             @default(BUSINESS_OWNER)
  status          UserStatus       @default(ACTIVE)
  themePreference String           @default("light")
  emailVerifiedAt DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil     DateTime?
  lastFailedLoginAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  refreshSessions          RefreshSession[]
  authTokens               AuthToken[]
  auditLogs                AuditLog[]
  createdWorkspaces        Workspace[]           @relation("WorkspaceCreatedBy")
  workspaceMemberships     WorkspaceMember[]
  sentInvitations          WorkspaceInvitation[] @relation("SentInvitations")
  connectedSocialAccounts  SocialAccount[]       @relation("SocialAccountsConnected")
  oauthStates              OAuthState[]          @relation("UserOAuthStates")
  oauthSessions            OAuthSession[]        @relation("UserOAuthSessions")
  createdDrafts            ContentDraft[]        @relation("DraftCreatedBy")
  updatedDrafts            ContentDraft[]        @relation("DraftUpdatedBy")
  approvalRequestedDrafts  ContentDraft[]        @relation("DraftApprovalRequestedBy")
  approvedDrafts           ContentDraft[]        @relation("DraftApprovedBy")
  contentRevisions         ContentRevision[]     @relation("RevisionCreatedBy")
  createdScheduledPosts    ScheduledPost[]       @relation("ScheduledPostCreatedBy")
  cancelledScheduledPosts  ScheduledPost[]       @relation("ScheduledPostCancelledBy")
  dismissedGrowthInsights  GrowthInsight[]       @relation("GrowthInsightDismissedBy")
  assignedSocialInteractions SocialInteraction[] @relation("InteractionAssignedTo")
  assignedBySocialInteractions SocialInteraction[] @relation("InteractionAssignedBy")
  resolvedSocialInteractions SocialInteraction[] @relation("InteractionResolvedBy")
  interactionReplyAttempts InteractionReplyAttempt[] @relation("ReplyAttemptAuthor")
  interactionNotes         InteractionNote[]     @relation("InteractionNoteAuthor")
  inboxNotifications       InboxNotification[]   @relation("InboxNotificationRecipient")
  uploadedMediaAssets      MediaAsset[]          @relation("MediaAssetUploadedBy")
  shortenedLinks           ShortenedLink[]       @relation("ShortenedLinkCreatedBy")
  createdListeningQueries  ListeningQuery[]      @relation("ListeningQueryCreatedBy")
  draftComments            DraftComment[]        @relation("DraftCommentAuthor")
  resolvedComments         DraftComment[]        @relation("DraftCommentResolvedBy")
  reviewedDraftSteps       DraftStepReview[]     @relation("DraftStepReviewer")
  createdReportSchedules   ExecutiveReportSchedule[] @relation("ReportScheduleCreatedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Workspace {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  description     String?
  logoUrl         String?
  websiteUrl      String?
  industry        String?
  timezone        String          @default("UTC")
  defaultLanguage String          @default("en")
  status          WorkspaceStatus @default(ACTIVE)
  planTier        String          @default("FREE")
  storageQuotaBytes BigInt        @default(5368709120)
  maxMediaAssets  Int             @default(500)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String

  createdBy      User                   @relation("WorkspaceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  auditLogs      AuditLog[]
  socialAccounts SocialAccount[]
  oauthStates    OAuthState[]
  oauthSessions  OAuthSession[]
  brandProfile              WorkspaceBrandProfile?
  contentDrafts             ContentDraft[]
  scheduledPosts            ScheduledPost[]
  accountAnalyticsSnapshots AccountAnalyticsSnapshot[]
  postAnalyticsSnapshots    PostAnalyticsSnapshot[]
  analyticsSyncJobs         AnalyticsSyncJob[]
  growthInsights            GrowthInsight[]
  socialInteractions        SocialInteraction[]
  interactionReplyAttempts  InteractionReplyAttempt[]
  interactionNotes          InteractionNote[]
  inboxSyncCheckpoints      InboxSyncCheckpoint[]
  inboxNotifications        InboxNotification[]
  mediaAssets               MediaAsset[]
  subscription              WorkspaceSubscription?
  invoices                  BillingInvoice[]
  automationRules           AutomationRule[]
  automationLogs            AutomationExecutionLog[]
  shortenedLinks            ShortenedLink[]
  listeningQueries          ListeningQuery[]
  listeningMentions         ListeningMention[]
  approvalWorkflows         ApprovalWorkflow[]
  draftComments             DraftComment[]
  whiteLabelConfig          WhiteLabelConfig?
  reportSchedules           ExecutiveReportSchedule[]
  generatedReports          GeneratedExecutiveReport[]
  moderationRules           InboxModerationRule[]
  autoReplyTemplates        InboxAutoReplyTemplate[]
  competitorProfiles        CompetitorProfile[]
  webhookSubscriptions      WebhookSubscription[]
  webhookDeliveryLogs       WebhookDeliveryLog[]

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole         @default(EDITOR)
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(EDITOR)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model SocialAccount {
  id                   String                 @id @default(uuid())
  workspaceId          String
  provider             SocialProvider
  providerAccountId    String
  accountName          String
  accountUsername      String?
  accountType          SocialAccountType
  profileImageUrl      String?
  connectionStatus     SocialConnectionStatus @default(CONNECTED)
  encryptedAccessToken String
  grantedScopes        String[]
  tokenExpiresAt       DateTime?
  lastValidatedAt      DateTime               @default(now())
  connectedByUserId    String
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy      User                  @relation("SocialAccountsConnected", fields: [connectedByUserId], references: [id], onDelete: Restrict)
  scheduledTargets          ScheduledPostTarget[]
  accountAnalyticsSnapshots AccountAnalyticsSnapshot[]
  postAnalyticsSnapshots    PostAnalyticsSnapshot[]
  analyticsSyncJobs         AnalyticsSyncJob[]
  analyticsSyncErrors       AnalyticsSyncError[]
  socialInteractions        SocialInteraction[]
  inboxSyncCheckpoint       InboxSyncCheckpoint?

  @@unique([workspaceId, provider, providerAccountId])
  @@index([workspaceId])
  @@index([provider, providerAccountId])
  @@index([connectionStatus])
  @@map("social_accounts")
}

model OAuthState {
  id          String         @id @default(uuid())
  state       String         @unique
  workspaceId String
  userId      String
  provider    SocialProvider
  redirectUri String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserOAuthStates", fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("oauth_states")
}

model OAuthSession {
  id                 String         @id @default(uuid())
  sessionTokenHash   String         @unique
  workspaceId        String
  userId             String
  provider           SocialProvider
  encryptedPayload   String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("UserOAuthSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionTokenHash])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("oauth_sessions")
}

model WorkspaceBrandProfile {
  id                   String    @id @default(uuid())
  workspaceId          String    @unique
  businessName         String
  industry             String?
  businessDescription  String?
  targetAudience       String?
  productsAndServices  String?
  brandVoice           String?
  preferredLanguage    String    @default("en")
  supportedLanguages   String[]  @default(["en"])
  primaryColor         String?
  secondaryColor       String?
  logoUrl              String?
  slogan               String?
  websiteUrl           String?
  contactDetails       Json?
  brandGuidelines      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_brand_profiles")
}

model ContentDraft {
  id                         String            @id @default(uuid())
  workspaceId                String
  createdByUserId            String
  updatedByUserId            String?
  title                      String
  objective                  CampaignObjective @default(ENGAGEMENT)
  contentType                ContentType       @default(POST)
  language                   String            @default("en")
  status                     DraftStatus       @default(DRAFT)
  approvalRequestedByUserId  String?
  approvedByUserId           String?
  approvedAt                 DateTime?
  rejectionReason            String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User              @relation("DraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy           User?             @relation("DraftUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  approvalRequestedBy User?             @relation("DraftApprovalRequestedBy", fields: [approvalRequestedByUserId], references: [id], onDelete: SetNull)
  approvedBy          User?             @relation("DraftApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvalWorkflowId  String?
  approvalWorkflow    ApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id], onDelete: SetNull)
  stepReviews         DraftStepReview[]
  comments            DraftComment[]
  variants            ContentVariant[]
  revisions           ContentRevision[]
  scheduledPosts      ScheduledPost[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdByUserId])
  @@index([approvalRequestedByUserId])
  @@index([approvedByUserId])
  @@map("content_drafts")
}

model ContentVariant {
  id             String         @id @default(uuid())
  draftId        String
  platform       SocialPlatform
  headline       String?
  body           String
  callToAction   String?
  hashtags       String[]       @default([])
  linkUrl        String?
  mediaBrief     String?
  mediaAssetUrl  String?
  mediaAssetId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  draft      ContentDraft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?       @relation("VariantMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  revisions  ContentRevision[]

  @@index([draftId])
  @@index([mediaAssetId])
  @@index([platform])
  @@map("content_variants")
}

model ContentRevision {
  id              String   @id @default(uuid())
  draftId         String
  variantId       String?
  revisionNumber  Int
  action          String
  promptSummary   String?
  inputSnapshot   Json?
  outputSnapshot  Json
  createdByUserId String
  createdAt       DateTime @default(now())

  draft         ContentDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  variant       ContentVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdByUser User            @relation("RevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([draftId, revisionNumber])
  @@index([draftId])
  @@index([variantId])
  @@index([createdByUserId])
  @@map("content_revisions")
}

model FestivalOccasion {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String
  culturalContext   String
  category          String
  dateType          String
  typicalPeriod     String
  supportedRegions  String[] @default(["All India"])
  promptGuidance    String
  suggestedHashtags String[] @default([])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("festival_occasions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actorUser User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ScheduledPostStatus {
  SCHEDULED
  PROCESSING
  PARTIALLY_PUBLISHED
  PUBLISHED
  FAILED
  CANCELLED
  NEEDS_REAPPROVAL
}

enum PublishTargetStatus {
  PENDING
  DISPATCHING
  PUBLISHED
  FAILED
  AUTH_REQUIRED
  AMBIGUOUS_TIMEOUT
  RETRYING
  CANCELLED
  SKIPPED
}

enum AttemptOutcome {
  SUCCESS
  DEFINITIVE_FAILURE
  AMBIGUOUS_TIMEOUT
  AUTH_FAILURE
  RATE_LIMITED
}

model ScheduledPost {
  id                     String              @id @default(uuid())
  workspaceId            String
  draftId                String
  createdById            String
  scheduledAt            DateTime
  timezone               String              @default("UTC")
  status                 ScheduledPostStatus @default(SCHEDULED)
  approvedRevisionNumber Int
  contentSnapshot        Json
  snapshotHash           String
  queueJobId             String?
  cancelledAt            DateTime?
  cancelledById          String?
  cancellationReason     String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  draft                  ContentDraft        @relation(fields: [draftId], references: [id], onDelete: Restrict)
  createdBy              User                @relation("ScheduledPostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy            User?               @relation("ScheduledPostCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  targets                ScheduledPostTarget[]

  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, status])
  @@index([draftId])
  @@index([scheduledAt, status])
  @@map("scheduled_posts")
}

model ScheduledPostTarget {
  id              String              @id @default(uuid())
  scheduledPostId String
  socialAccountId String
  platform        SocialPlatform
  variantId       String?
  status          PublishTargetStatus @default(PENDING)
  externalPostId  String?
  externalPostUrl String?
  attemptCount    Int                 @default(0)
  maxAttempts     Int                 @default(3)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  publishedAt     DateTime?
  errorCode       String?
  errorMessage    String?
  rawResponse     Json?
  idempotencyKey  String              @unique @default(uuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  scheduledPost   ScheduledPost       @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  attempts               PublishingAttempt[]
  postAnalyticsSnapshots PostAnalyticsSnapshot[]

  @@unique([scheduledPostId, socialAccountId])
  @@index([scheduledPostId])
  @@index([socialAccountId])
  @@index([status, nextRetryAt])
  @@map("scheduled_post_targets")
}

model PublishingAttempt {
  id                    String         @id @default(uuid())
  targetId              String
  attemptNumber         Int
  startedAt             DateTime       @default(now())
  completedAt           DateTime?
  outcome               AttemptOutcome
  sanitizedErrorCode    String?
  sanitizedErrorMessage String?
  externalPostId        String?
  reconciliationStatus  String?
  reconciledAt          DateTime?
  metadata              Json?

  target                ScheduledPostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, attemptNumber])
  @@index([targetId])
  @@index([outcome])
  @@map("publishing_attempts")
}

enum AnalyticsMetricPeriod {
  DAY
  WEEK
  DAYS_28
  LIFETIME
}

enum PostAnalyticsType {
  POST
  IMAGE
  VIDEO
  REEL
  CAROUSEL
  STORY
}

enum SyncJobType {
  ACCOUNT_DAILY
  POST_INCREMENTAL
  MANUAL_REFRESH
  HISTORICAL_BACKFILL
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED
}

enum GrowthInsightCategory {
  TIMING
  CONTENT_FORMAT
  ENGAGEMENT
  TOPIC_AUDIENCE
  CONSISTENCY
}

model AccountAnalyticsSnapshot {
  id                 String                @id @default(uuid())
  workspaceId        String
  socialAccountId    String
  platform           SocialPlatform
  period             AnalyticsMetricPeriod @default(DAY)
  snapshotDate       DateTime
  followersCount     Int?
  followersNetChange Int?
  impressions        Int?
  reach              Int?
  profileViews       Int?
  websiteClicks      Int?
  engagementTotal    Int?
  engagementRate     Float?
  provenance         String?
  rawMetrics         Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount         @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, period, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([socialAccountId, snapshotDate])
  @@index([workspaceId, platform, snapshotDate])
  @@map("account_analytics_snapshots")
}

model PostAnalyticsSnapshot {
  id                    String               @id @default(uuid())
  workspaceId           String
  socialAccountId       String
  scheduledPostTargetId String?
  externalPostId        String
  platform              SocialPlatform
  postType              PostAnalyticsType    @default(POST)
  publishedAt           DateTime?
  snapshotDate          DateTime
  likesCount            Int?
  commentsCount         Int?
  sharesCount           Int?
  savesCount            Int?
  impressions           Int?
  reach                 Int?
  clicks                Int?
  videoViews            Int?
  watchTimeMs           BigInt?
  engagementRate        Float?
  provenance            String?
  rawMetrics            Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount         SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  scheduledPostTarget   ScheduledPostTarget? @relation(fields: [scheduledPostTargetId], references: [id], onDelete: SetNull)

  @@unique([socialAccountId, externalPostId, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([socialAccountId, snapshotDate])
  @@index([externalPostId])
  @@index([scheduledPostTargetId])
  @@index([workspaceId, platform, snapshotDate])
  @@map("post_analytics_snapshots")
}

model AnalyticsSyncJob {
  id                   String               @id @default(uuid())
  workspaceId          String
  socialAccountId      String?
  jobType              SyncJobType
  status               SyncJobStatus        @default(QUEUED)
  startedAt            DateTime?
  completedAt          DateTime?
  itemsProcessed       Int                  @default(0)
  itemsFailed          Int                  @default(0)
  lastSuccessfulSyncAt DateTime?
  leaseExpiresAt       DateTime?
  claimToken           String?
  errorCode            String?
  errorMessage         String?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount        SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  errors               AnalyticsSyncError[]

  @@index([workspaceId, status])
  @@index([socialAccountId, status])
  @@index([status, leaseExpiresAt])
  @@map("analytics_sync_jobs")
}

model AnalyticsSyncError {
  id                String            @id @default(uuid())
  syncJobId         String
  socialAccountId   String?
  externalPostId    String?
  errorCode         String
  errorMessage      String
  httpStatus        Int?
  isPermissionError Boolean          @default(false)
  createdAt         DateTime         @default(now())

  syncJob           AnalyticsSyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([syncJobId])
  @@index([socialAccountId])
  @@index([isPermissionError])
  @@map("analytics_sync_errors")
}

model GrowthInsight {
  id              String                @id @default(uuid())
  workspaceId     String
  category        GrowthInsightCategory
  title           String
  summary         String
  suggestedAction String
